<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cache-Control headers for the live host (IIS/Plesk). Neither .htaccess (Apache)
  nor netlify.toml/vercel.json apply here, so every static asset was being served
  with no Cache-Control header at all. Mirrors the caching intent already written
  in netlify.toml/vercel.json: 1 year immutable for css/js/image/webfonts, 1 hour
  for everything else (HTML).
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=3600, must-revalidate" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <location path="css">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <clear />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <clear />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="image">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <clear />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="webfonts">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <clear />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
